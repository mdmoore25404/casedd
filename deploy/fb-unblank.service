[Unit]
Description=CASEDD framebuffer unblank on local input
Documentation=https://github.com/mdmoore25404/casedd
After=local-fs.target

[Service]
Type=simple
# Run as root so it can read input devices and write sysfs blank
ExecStart=/usr/bin/env PYTHONPATH=@CASEDD_REPO_ROOT@ @CASEDD_REPO_ROOT@/.venv/bin/python3 @CASEDD_REPO_ROOT@/scripts/fb_unblank_daemon.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
