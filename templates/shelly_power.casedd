# shelly_power.casedd - local Shelly smart plug power dashboard

name: shelly_power
description: Live power, current, voltage, and cumulative energy for a Shelly smart plug.
aspect_ratio: "5:3"
layout_mode: fit
refresh_rate: 2.0

grid:
  template_areas: |
    power_graph power_graph
    power_now   current
    voltage     energy
  columns: 1fr 1fr
  rows: 1.6fr 1fr 1fr

background: "#10151c"

widgets:
  power_graph:
    type: sparkline
    label: "Shelly Power (W)"
    source: shelly.power
    padding: [6, 8]
    unit: W
    precision: 1
    min: 0
    max: 2500
    samples: 180
    window_seconds: 900
    color_stops:
      - [0, "#3ecf8e"]
      - [800, "#f8b84a"]
      - [1600, "#f06a6a"]

  power_now:
    type: value
    label: Power Now
    source: shelly.power
    precision: 1
    unit: "W"
    padding: [6, 8]
    color: "#e9f2ff"

  current:
    type: value
    label: Current
    source: shelly.current
    precision: 3
    unit: "A"
    padding: [6, 8]
    color: "#d7f0ff"

  voltage:
    type: value
    label: Voltage
    source: shelly.voltage
    precision: 1
    unit: "V"
    padding: [6, 8]
    color: "#ffe6ad"

  energy:
    type: value
    label: Total Energy
    source: shelly.energy
    precision: 3
    unit: "kWh"
    padding: [6, 8]
    color: "#ffd3e6"
