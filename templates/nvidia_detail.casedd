# nvidia_detail.casedd — Detailed NVIDIA GPU dashboard
#
# Shown automatically when a GPU trigger fires (use, VRAM, or temperature).
# Displays all nvidia-smi metrics for GPU 0 (index 0 — the GPU driving the
# physical display) plus a summary column for any additional GPUs
# (nvidia.1.*, nvidia.2.*, ...) reported by nvidia-smi on multi-GPU hosts.
# On single-GPU hosts the GPU 1 widgets simply show "--" since their source
# keys are absent from the data store.

name: nvidia_detail
description: >
  Full-detail NVIDIA GPU view triggered when the primary GPU is under
  stress. Shows utilisation, temperature, VRAM usage, and power draw with
  colour-coded sparklines and gauges for GPU 0, plus a compact summary
  panel for a second GPU when present.
aspect_ratio: "5:3"
layout_mode: fit
refresh_rate: 2.0
background: "#0a0f14"

grid:
  # 6 columns, 4 rows:
  # Row 1-2 (largest): GPU0 use sparkline | GPU0 temp sparkline | GPU0 VRAM gauge
  # Row 3:             GPU0 name | GPU0 VRAM used | GPU0 power
  # Row 4:             GPU0 VRAM free/total/count (left) | GPU1 summary (right)
  template_areas: |
    gpu0_use     gpu0_use     gpu0_temp    gpu0_temp    vram_gauge   vram_gauge
    gpu0_use     gpu0_use     gpu0_temp    gpu0_temp    vram_gauge   vram_gauge
    gpu0_name    vram_used    power_hist   power_hist   gpu1_use     gpu1_use
    vram_free    vram_total   gpu_count    gpu1_temp    gpu1_vram    gpu1_power
  columns: 1fr 1fr 1fr 1fr 1fr 1fr
  rows: 1.3fr 0.9fr 0.8fr 0.7fr

widgets:
  gpu0_use:
    type: sparkline
    label: "GPU0 Use (%)"
    source: nvidia.0.percent
    padding: [6, 8]
    precision: 1
    unit: "%"
    min: 0
    max: 100
    samples: 120
    window_seconds: 120
    color_stops:
      - [0,  "#22cc44"]
      - [50, "#ffcc00"]
      - [75, "#ff8800"]
      - [90, "#ff2222"]

  gpu0_temp:
    type: sparkline
    label: "GPU0 Temp (°C)"
    source: nvidia.0.temperature
    padding: [6, 8]
    unit: "°C"
    precision: 1
    min: 20
    max: 100
    samples: 180
    window_seconds: 300
    color_stops:
      - [30, "#22aaff"]
      - [65, "#ffcc00"]
      - [80, "#ff8800"]
      - [90, "#ff2222"]

  vram_gauge:
    type: gauge
    label: "GPU0 VRAM %"
    source: nvidia.0.memory_percent
    padding: [6, 4]
    min: 0
    max: 100
    unit: "%"
    arc_start: 180
    arc_end: 360
    color_stops:
      - [0,  "#22aaff"]
      - [70, "#ffcc00"]
      - [90, "#ff2222"]

  gpu0_name:
    type: value
    label: "GPU0 Model"
    source: nvidia.0.name
    padding: [4, 6]
    color: "#d7d9ea"
    font_size: auto

  vram_used:
    type: value
    label: "GPU0 VRAM Used"
    source: nvidia.0.memory_used_mb
    padding: [4, 8]
    precision: 0
    unit: "MB"
    color: "#ffb266"
    font_size: auto

  power_hist:
    type: sparkline
    label: "GPU0 Power (W)"
    source: nvidia.0.power_w
    padding: [4, 8]
    precision: 0
    unit: "W"
    min: 0
    samples: 60
    window_seconds: 120
    color: "#f0a040"

  vram_free:
    type: value
    label: "GPU0 VRAM Free"
    source: nvidia.0.memory_free_mb
    padding: [2, 8]
    precision: 0
    unit: "MB"
    color: "#5daaff"
    font_size: auto

  vram_total:
    type: value
    label: "GPU0 VRAM Total"
    source: nvidia.0.memory_total_mb
    padding: [2, 8]
    precision: 0
    unit: "MB"
    color: "#8888aa"
    font_size: auto

  gpu_count:
    type: value
    label: "GPU Count"
    source: nvidia.gpu_count
    padding: [2, 8]
    precision: 0
    color: "#aaaacc"
    font_size: auto

  # --- Second GPU summary column (nvidia.1.*) ---
  # Shows "--" gracefully on single-GPU hosts where these keys are absent.

  gpu1_use:
    type: sparkline
    label: "GPU1 Use (%)"
    source: nvidia.1.percent
    padding: [4, 8]
    precision: 1
    unit: "%"
    min: 0
    max: 100
    samples: 90
    window_seconds: 120
    color_stops:
      - [0,  "#22cc44"]
      - [50, "#ffcc00"]
      - [75, "#ff8800"]
      - [90, "#ff2222"]

  gpu1_temp:
    type: value
    label: "GPU1 Temp"
    source: nvidia.1.temperature
    padding: [2, 8]
    precision: 1
    unit: "°C"
    color: "#5daaff"
    font_size: auto

  gpu1_vram:
    type: value
    label: "GPU1 VRAM"
    source: nvidia.1.memory_percent
    padding: [2, 8]
    precision: 0
    unit: "%"
    color: "#ffcc00"
    font_size: auto

  gpu1_power:
    type: value
    label: "GPU1 Power"
    source: nvidia.1.power_w
    padding: [2, 8]
    precision: 0
    unit: "W"
    color: "#f0a040"
    font_size: auto
